rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isParticipant() {
      return isAuth() && request.auth.uid in resource.data.participants;
    }
    function willBeParticipant() {
      return isAuth() && request.auth.uid in request.resource.data.participants;
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    // Cloud Function syncPresenceToFirestore also writes
                    || request.auth == null;

      match /blockedUsers/{targetId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Key Bundles (Signal Protocol) ────────────────────────────
    match /keyBundles/{uid} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid);
    }

    // ── Chats ────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow delete: if isAuth()
                    && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read:   if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ── Calls ────────────────────────────────────────────────────
    // A call belongs to its caller and its callee. No one else may read or
    // write it, and each side writes only its own part. The Cloud Functions
    // use the Admin SDK, which these rules do not apply to.
    // Tests: firestore-rules-tests/calls.test.js.
    match /calls/{callId} {
      // The status moves only along these steps:
      //   ringing  → ringing    the caller writes the offer, the callee its answer
      //   ringing  → answered   callee only
      //   ringing  → declined   callee only
      //   answered → answered   callee only, to write its answer
      //   any      → ended      either side
      // A call that was declined can still end, because a hang-up can race the
      // decline. An ended call can end again, because both sides can hang up at
      // once. Nothing leaves "ended", and nothing goes back to "ringing" or
      // "answered".
      function isAllowedCallUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        let byCaller = request.auth.uid == resource.data.callerId;
        let byCallee = request.auth.uid == resource.data.calleeId;
        // callerId, calleeId and createdAt never change.
        return changed.hasOnly(['status', 'endReason', 'endedAt', 'offer', 'answer'])
          && (!changed.hasAny(['offer']) || byCaller)
          && (!changed.hasAny(['answer']) || byCallee)
          // The offer and the answer are written only while the call is set up.
          && (!changed.hasAny(['offer', 'answer']) || newStatus in ['ringing', 'answered'])
          // The end fields are written only by the write that ends the call.
          && (!changed.hasAny(['endReason', 'endedAt']) || newStatus in ['declined', 'ended'])
          && ((oldStatus == 'ringing' && newStatus == 'ringing')
              || (oldStatus == 'ringing' && newStatus in ['answered', 'declined'] && byCallee)
              || (oldStatus == 'answered' && newStatus == 'answered' && byCallee)
              || newStatus == 'ended');
      }

      // For the candidate lists: the parent call, as stored.
      function storedCall() {
        return get(/databases/$(database)/documents/calls/$(callId)).data;
      }
      function isInStoredCall() {
        let call = storedCall();
        return isAuth() && request.auth.uid in [call.callerId, call.calleeId];
      }
      function isIceCandidate() {
        let candidate = request.resource.data;
        return candidate.keys().hasOnly(['sdpMid', 'sdpMLineIndex', 'sdp'])
          && candidate.sdpMid is string
          && candidate.sdpMLineIndex is int
          && candidate.sdp is string;
      }

      allow read:   if isAuth()
                    && (request.auth.uid == resource.data.callerId
                    ||  request.auth.uid == resource.data.calleeId);
      // The caller creates the call, ringing, to someone else, with no answer.
      // The key list is every field the app writes. A new field needs it changed.
      allow create: if isAuth()
                    && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'status', 'createdAt',
                                                             'endedAt', 'endReason', 'offer', 'answer'])
                    && request.auth.uid == request.resource.data.callerId
                    && request.resource.data.calleeId is string
                    && request.resource.data.calleeId != request.auth.uid
                    && request.resource.data.status == 'ringing'
                    && request.resource.data.get('answer', null) == null;
      allow update: if isAuth()
                    && (request.auth.uid == resource.data.callerId
                    ||  request.auth.uid == resource.data.calleeId)
                    && isAllowedCallUpdate();

      // ICE candidates carry each phone's network addresses. Only the two
      // people in the call may read them. Each side adds only to its own list,
      // and no one changes or deletes a candidate.
      match /callerCandidates/{candidateId} {
        allow read:   if isInStoredCall();
        allow create: if isAuth()
                      && request.auth.uid == storedCall().callerId
                      && isIceCandidate();
      }
      match /calleeCandidates/{candidateId} {
        allow read:   if isInStoredCall();
        allow create: if isAuth()
                      && request.auth.uid == storedCall().calleeId
                      && isIceCandidate();
      }
    }

    // ── Lists ────────────────────────────────────────────────────
    match /lists/{listId} {
      allow read:   if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow delete: if isAuth()
                    && resource.data.createdBy == request.auth.uid;

      match /history/{entryId} {
        allow read:   if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.participants;
        allow create: if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.participants;
      }

      match /items/{itemId} {
        allow read, write: if isAuth()
                           && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.participants;
      }
    }

    // ── Sticker Packs ────────────────────────────────────────────
    // One manifest per pack: the backup of its owner's library, and what
    // "View pack" reads for anyone a sticker from it was sent to. A pack id is
    // random, so only someone who was given it can get the document. Listing
    // is the owner's alone, and so is every write.
    match /stickerPacks/{packId} {
      allow get:    if isAuth();
      allow list:   if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId;
      // Deleting a manifest that was never written is allowed: the app deletes
      // by id without knowing whether an upload ever landed.
      allow delete: if isAuth()
                    && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // ── Invite Links ─────────────────────────────────────────────
    match /inviteLinks/{token} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
    }
  }
}
