<?xml version="1.0" encoding="utf-8"?>
<!-- PROTOTYPE: throwaway. Lives on prototype/video-call and is never merged into main.
     Debug builds get a second launcher icon that opens the video call prototype without a
     login. A release build has no entry for it. Plan: docs/plans/video-calls.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.firestream.chat.ui.call.prototype.VideoCallPrototypeActivity"
            android:exported="true"
            android:label="Video call prototype"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity=".callprototype"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
